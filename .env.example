# Wound Care 3D Photogrammetry Agent - Environment Configuration
# Do not store real patient data in this experimental application.

# Replace with a unique cryptographically random secret (e.g. python -c
# "import secrets; print(secrets.token_hex(32))") before production deployment.
# Empty means a random process-local development key is generated; logs cannot
# be validated across restarts and are never durable.
AUDIT_SECRET_KEY=

# Only deterministic mock inference is implemented by the current source.
MODEL_PROVIDER=mock
